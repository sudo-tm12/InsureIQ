# InsurIQ — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored by Next.js defaults.

# ─── Sanity CMS ─────────────────────────────────────────────
# Project ID from sanity.io/manage
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Read token for server-side queries (created in Sanity manage → API)
SANITY_API_TOKEN=

# Public mirrors — must be NEXT_PUBLIC_* to be exposed to the browser
# for the embedded Sanity Studio and CDN reads.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ─── Transactional email (Resend) ───────────────────────────
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend, or no email
# (client quotes, lead notifications) is delivered.
RESEND_FROM=InsurIQ <quotes@insuriq.co.za>
# Inbox that receives new lead notifications
LEADS_NOTIFICATION_EMAIL=

# ─── Quote calculator (server-only) ─────────────────────────
# AES-256-GCM key for src/server/ratebook/ratebook.enc: base64 of 32 bytes.
# Must be the key the rate book was encrypted with (npm run rates:import).
RATEBOOK_KEY=

# ─── Lead store (server-only) ───────────────────────────────
# Neon / Vercel Postgres connection string. REQUIRED IN PRODUCTION: without
# it leads fall back to a local file, and every form submission fails on
# Vercel's read-only filesystem. Create the table once: npm run leads:migrate
DATABASE_URL=
# AES-256-GCM key that encrypts every stored lead: base64 of 32 bytes.
# Keep it separate from RATEBOOK_KEY (the code falls back to that key if this
# is unset). Losing it makes every stored lead unreadable — back it up.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LEADS_KEY=
# POPIA retention window in months (default 24)
LEADS_RETENTION_MONTHS=24

# ─── Analytics ──────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ─── WhatsApp ───────────────────────────────────────────────
# International format, digits only — e.g. 27821234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Site URL ───────────────────────────────────────────────
# Used for canonical URLs, OG metadata, sitemap, robots.txt
NEXT_PUBLIC_SITE_URL=https://www.insuriq.co.za
